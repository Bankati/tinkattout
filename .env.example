# Modèle des variables d'environnement de l'École Tinka-Tout.
# Copier ce fichier en .env (lu par Prisma et par Next.js) puis remplacer TOUTES les valeurs.
# Les valeurs ci-dessous sont factices. Ne jamais committer le vrai fichier .env.
# En local, utiliser une base de développement, jamais la base de production.

# --- Base de données (Supabase) -------------------------------------------
# Supabase > Project Settings > Database > Connection string > "Connection pooling".

# Utilisée par l'application : pooler en mode TRANSACTION, port 6543.
# pgbouncer=true : désactive les requêtes préparées, incompatibles avec ce mode.
# connection_limit=1 : une seule connexion par fonction serverless Vercel.
DATABASE_URL="postgresql://postgres.exempleref123:mot-de-passe-factice@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Utilisée par Prisma Migrate (migrate dev / migrate deploy) : pooler en mode SESSION, port 5432.
# Le mode session garde le verrou dont Prisma Migrate a besoin.
DIRECT_URL="postgresql://postgres.exempleref123:mot-de-passe-factice@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Authentification admin -------------------------------------------------
# Clé de signature des sessions admin (au moins 32 caractères aléatoires).
# Générer avec : openssl rand -base64 32
# ou sans openssl : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Une valeur différente pour chaque environnement (local, preview, production).
AUTH_SECRET="remplacer-par-une-valeur-generee-aleatoirement"

# --- Compte admin créé par le seed (npm run db:seed) -------------------------
# L'email est enregistré en minuscules. Mot de passe : 12 caractères minimum.
# Un compte existant n'est pas modifié, sauf si RESET_ADMIN_PASSWORD=1.
ADMIN_EMAIL="admin@exemple.tg"
ADMIN_PASSWORD="remplacer-par-un-mot-de-passe-long"
# RESET_ADMIN_PASSWORD=1

# --- Sauvegarde (GitHub Actions, pas dans .env) -------------------------------
# DATABASE_BACKUP_URL et BACKUP_PASSPHRASE sont des secrets du dépôt GitHub
# (Settings > Secrets and variables > Actions). Voir README, section Sauvegarde.
